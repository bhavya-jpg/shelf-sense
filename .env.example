# Copy to .env and fill in your API key. Never commit .env.
# AMD Developer Cloud Token Factory OpenAI-compatible base URL (ends in /v1).
AMD_API_URL=https://developer.amd.com.cn/radeon/api/v1
# Your Token Factory API key.
AMD_API_KEY=<your-token-factory-api-key>
# Vision-capable model, exactly as the endpoint lists it.
MODEL_NAME=Gemma-4-31B-IT
# Local UI development only. Must be false for every demo recording and the deployed app.
MOCK_MODE=false
